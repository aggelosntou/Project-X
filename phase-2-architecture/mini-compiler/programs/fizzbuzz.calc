// programs/fizzbuzz.calc
// FizzBuzz for i = 1..20
// Since print only handles integers, we encode:
//   FizzBuzz (div by 15) → print 0
//   Fizz     (div by  3) → print 3
//   Buzz     (div by  5) → print 5
//   otherwise            → print i
//
// Expected output:
//   1 2 3 5 4 3 7 5 8 9 10 0 11 3 13 5 14 0 16 17
// (one number per line)

var i = 1;
while (i <= 20) {
    if (i % 15 == 0) {
        print 0;
    } else {
        if (i % 3 == 0) {
            print 3;
        } else {
            if (i % 5 == 0) {
                print 5;
            } else {
                print i;
            }
        }
    }
    i = i + 1;
}
