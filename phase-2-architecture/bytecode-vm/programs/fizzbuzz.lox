// fizzbuzz.lox — FizzBuzz 1..30 using while loop and modulo

var i = 1;
var limit = 30;

while (i <= limit) {
    if (i % 15 == 0) {
        print "FizzBuzz";
    } else {
        if (i % 3 == 0) {
            print "Fizz";
        } else {
            if (i % 5 == 0) {
                print "Buzz";
            } else {
                print i;
            }
        }
    }
    i = i + 1;
}
